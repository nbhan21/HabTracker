VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_SYNC_TOOLS=true

# Feature flags
# When false, the app will NOT persist to localStorage or IndexedDB
VITE_ENABLE_OFFLINE=false

# When false, the Sync & Backup panel is hidden in non-dev environments
VITE_ENABLE_SYNC_TOOLS=false

# When true, allows local→cloud migration actions (push/import/reset)
VITE_ALLOW_LOCAL_MIGRATION=false
