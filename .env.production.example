# Copy this file to .env.production and fill the values before deploying
# Do NOT commit real secrets to the repo.

# Frontend (public)
VITE_CLERK_PUBLISHABLE_KEY=pk_...

# Backend (server-only, keep secret)
CLERK_SECRET_KEY=sk_...
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_...

# Legacy/dev (optional local dev keys; do NOT use service role in browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Notes:
# - Only VITE_ prefixed variables are exposed to the browser.
# - For Vercel/Netlify, set these values in the project environment settings instead of committing.
# - Keep .env (or .env.local) for local development; use .env.production for local production builds or self-hosting.
